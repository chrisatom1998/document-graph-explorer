{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "exec npx vite --port \"${PORT:-5173}\" --strictPort"
      ],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "dev-alt",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "--port",
        "5199",
        "--strictPort"
      ],
      "port": 5199
    },
    {
      "name": "preview-dist",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "exec npx vite preview --port \"${PORT:-4173}\" --strictPort"
      ],
      "port": 4173,
      "autoPort": true
    },
    {
      "name": "dj-test-set",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "scripts/dj-test-set-server.py",
        "artifacts/dj-test-set",
        "5210"
      ],
      "port": 5210
    },
    {
      "name": "dev-perf",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "--port",
        "5233",
        "--strictPort"
      ],
      "port": 5233
    },
    {
      "name": "distorted-check",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "DJ_REVIEW_DATA=artifacts/music-evaluation/distorted-check",
        "DJ_REVIEW_PORT=8767",
        "DJ_REVIEW_NO_APPLY=1",
        "python3",
        "scripts/dj-review-server.py"
      ],
      "port": 8767,
      "url": "http://127.0.0.1:8767"
    },
    {
      "name": "sound-label-studio",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "scripts/dj-review-server.py"
      ],
      "port": 8766,
      "url": "http://127.0.0.1:8766"
    }
  ]
}
